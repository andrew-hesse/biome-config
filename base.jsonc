{
  // Universal house preset: the formatter style and linter baseline shared by
  // every repo regardless of stack (Hono, Astro, Next, plain TS, CLIs). Stack-
  // specific linter exceptions belong in the hono overlay (./hono.jsonc) or in
  // the consuming repo, never here.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // Sane default for repos that do NOT set their own files.includes. Biome
    // CONCATENATES this array with a consumer's own includes (base first, then
    // the consumer; last match wins), so the "**" and these excludes stay in
    // effect on extend. A consumer that re-includes a broad path ("**",
    // "src/**") after these can pull back what base excluded and must repeat
    // the exclude (notably "!**/*.svg"). .wrangler/public are common build
    // outputs and harmless to exclude where absent.
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!.wrangler",
      "!public",
      "!**/generated",
      "!**/*.css",
      "!**/*.svg",
      // Agent-tooling config is committed but owned/formatted by Claude Code,
      // not Biome. Exclude only its config files and known tooling directories:
      // excluding the entire .claude directory also hides source in native
      // .claude/worktrees worktrees from `biome check .`.
      "!**/.claude/CLAUDE.md",
      "!**/.claude/*.json",
      "!**/.claude/agents",
      "!**/.claude/commands",
      "!**/.claude/hooks",
      "!**/.claude/rules",
      "!**/.claude/skills",
      "!**/lefthook.yml",
      "!**/lefthook-local.yml"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double", "semicolons": "asNeeded", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // House "high bar" - stricter than Biome's recommended set. Unused
      // imports/variables and untyped `any` are errors (not warnings), and Node
      // builtins must use the `node:` protocol. A repo that legitimately needs
      // `any` (e.g. mapping an untyped external API) overrides noExplicitAny to
      // "off" in its own config.
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "style": { "useImportType": "error", "useExportType": "error", "useNodejsImportProtocol": "error" },
      "suspicious": { "noExplicitAny": "error" }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      // Tests get slightly looser ergonomics than production code: non-null
      // assertions on known-present fixtures, and `any` mock-casts. The high
      // bar (no `any`) still applies to everything that ships in src.
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" }, "suspicious": { "noExplicitAny": "off" } } }
    }
  ]
}
