{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  // Universal house preset: the formatter style and linter baseline shared by
  // every repo regardless of stack (Hono, Astro, Next, plain TS, CLIs). Stack-
  // specific linter exceptions belong in a derived preset (./biome.jsonc for
  // Hono/cloudflare) or in the consuming repo, never here.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // Sane default for repos that do NOT set their own files.includes. Biome
    // REPLACES (does not merge) this array when a consumer declares its own
    // includes, so a repo with custom includes must re-list the excludes it
    // still wants (notably "!**/*.svg"). .wrangler/public are common build
    // outputs and harmless to exclude where absent.
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!.wrangler",
      "!public",
      "!**/generated",
      "!**/*.css",
      "!**/*.svg"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double", "semicolons": "asNeeded", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "useImportType": "error", "useExportType": "error" }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    { "includes": ["**/*.test.ts", "**/*.test.tsx"], "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } } }
  ]
}
