{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  // Hono overlay: ONLY the linter exceptions that make sense for the Hono +
  // Alpine Workers (the cloudflare org). This file is a delta layer, NOT a full
  // config - it deliberately does not extend base. Biome does not resolve a
  // nested `extends` when a config is itself pulled in through a package export
  // (base would silently drop and Biome would fall back to its formatter
  // defaults), so composition is done at the CONSUMER instead:
  //
  //   "extends": ["@ahesse/biome-config/base", "@ahesse/biome-config/hono"]
  //
  // base supplies the formatter/linter baseline; this overlay turns off the few
  // a11y/style rules that false-positive on Hono's JSX and Alpine attributes.
  "linter": {
    "rules": {
      "style": {
        // Hono's jsxRenderer augments `interface ContextRenderer` via declaration
        // merging in `declare module "hono"`; rewriting that call-signature
        // interface to a type alias breaks the merge (duplicate identifier).
        "useShorthandFunctionType": "off"
      },
      "a11y": {
        // Decorative icons inside labeled controls carry no extra semantics; the
        // control's aria-label is the a11y handle.
        "noSvgWithoutTitle": "off",
        // React-oriented rules that misread Hono + Alpine: they don't recognize
        // Hono's lowercase numeric `tabindex={0}` or Alpine's
        // `x-bind:aria-checked`, so they false-positive on intentional accessible
        // custom ARIA widgets. Every other a11y rule stays on.
        "useSemanticElements": "off",
        "useFocusableInteractive": "off"
      }
    }
  }
}
