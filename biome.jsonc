{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!.wrangler",
      "!public",
      "!**/generated",
      "!**/*.css",
      "!**/*.svg"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double", "semicolons": "asNeeded", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "useImportType": "error", "useExportType": "error", "useShorthandFunctionType": "off" },
      "a11y": { "noSvgWithoutTitle": "off", "useSemanticElements": "off", "useFocusableInteractive": "off" }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    { "includes": ["**/*.test.ts", "**/*.test.tsx"], "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } } }
  ]
}
